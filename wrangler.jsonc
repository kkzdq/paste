{
  // Cloudflare Workers 配置（"Deploy to Cloudflare" 按钮会读取此文件自动创建 Worker 并绑定资源）
  // 注意：部署前需将 kv_namespaces[0].id 替换为真实的 KV Namespace ID
  "name": "paste",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [
    {
      // 点击部署按钮时，Cloudflare 会提示选择或自动创建此 KV 命名空间
      "binding": "JTB",
      "id": "placeholder"
    }
  ]
}
